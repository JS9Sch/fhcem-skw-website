{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fhcem-skw-mvp-preview",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "261027",
      "simple": {
        "limit": 8,
        "period": 60
      }
    }
  ]
}
