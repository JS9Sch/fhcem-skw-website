{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fhcem-skw-website",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  // The church address. fhcem-skw.org redirects to www in src/router.js.
  "routes": [
    { "pattern": "www.fhcem-skw.org", "custom_domain": true },
    { "pattern": "fhcem-skw.org", "custom_domain": true }
  ],
  "durable_objects": {
    "bindings": [{ "name": "SESSIONS", "class_name": "PreviewSession" }]
  },
  "migrations": [{ "tag": "session-v1", "new_sqlite_classes": ["PreviewSession"] }],
  "d1_databases": [
    {
      "binding": "ATT_DB",
      "database_name": "fhcem-skw-church-hk",
      // Church Cloudflare account (Handler@), APAC primary for Hong Kong users. Moved from the old account 2026-11-26.
      "database_id": "d248fe1e-98ef-4025-b3bd-c0cca1f84016",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "261027",
      "simple": {
        "limit": 8,
        "period": 60
      }
    }
  ]
}
