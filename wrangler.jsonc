{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fhcem-skw-mvp-preview",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "SESSIONS", "class_name": "PreviewSession" }]
  },
  "migrations": [{ "tag": "session-v1", "new_sqlite_classes": ["PreviewSession"] }],
  "d1_databases": [
    {
      "binding": "ATT_DB",
      "database_name": "fhcem-skw-attendance",
      "database_id": "10e04db1-31ae-4c71-873e-1b9d393ca041",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "261027",
      "simple": {
        "limit": 8,
        "period": 60
      }
    }
  ]
}
